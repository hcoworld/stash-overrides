    - '^https?://(?:s3plus|flowplus)\.meituan\.net/v\d+/\w+/linglong/\w+\.(?:gif|jpg|mp4) - reject-200'
    - '^https?://p\d+\.meituan\.net/(?:bizad|wmbanner)/\w+\.jpg - reject-img'
    - '^https?://interface(?:3)?\.music\.163\.com/e?api/ad/(?:loading/(?:get|current)|get)(?:\?|$) - reject-dict'
    - '^https?://interface(?:3)?\.music\.163\.com/e?api/link/(?:position|scene)/show/resource(?:\?|$) - reject-dict'
    - '^https?://api\.(?:pinduoduo|yangkeduo)\.com/api/cappuccino/splash(?:\?|$) - reject-dict'
    - '^https?://ccsp-egmas\.sf-express\.com/cx-app-base/base/app/ad/queryAdImages(?:\?|$) - reject-dict'
    - '^https?://shopic\.sf-express\.com/crm/mobile/common/flashscreen(?:\?|$) - reject-dict'
    - '^https?://ucmp\.sf-express\.com/proxy/operation-platform/info-flow-adver/query(?:\?|$) - reject-dict'
    - '^https?://ma-adx\.ctrip\.com/_ma\.gif(?:\?|$) - reject-img'
    - '^https?://m\.ctrip\.com/restapi/soa2/\d+/scjson/tripAds(?:\?|$) - reject-dict'
    - '^https?://homefront\.qunar\.com/front/splash/ad(?:\?|$) - reject-dict'
    - '^https?://client\.qunar\.com/pitcher-proxy\?qrt=p_splashAd(?:&|$) - reject-dict'
    - '^https?://r\.inews\.qq\.com/(?:adsBlacklist|getFullScreenPic|getBannerAds|getSplash)(?:\?|$) - reject-dict'
    - '^https?://api\.weibo\.cn/\d+/ad/preload(?:\?|$) - reject-dict'
    - '^https?://boot\.biz\.weibo\.com/v\d+/ad/(?:preload|realtime)(?:\?|$) - reject-dict'
    - '^https?://m?api\.weibo\.(?:cn|com)/\d+/ad/weibointl\? - reject-dict'
    - '^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/system_service/splash(?:\?|$) - reject-dict'
    - '^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/(?:tag/)?ads(?:\?|$) - reject-dict'
    - '^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/search/notes/recommend_info\? - reject-dict'
    - '^https?://(?:adse\.wsa|adse|adbehavior|xdcs-collector)\.ximalaya\.com/ - reject-200'
    - '^https?://[^/]+\.ximalaya\.com/api/v\d+/adRealTime(?:\?|$) - reject-dict'
    - '^https?://[^/]+\.ximalaya\.com/ting/(?:loading|feed|home)(?:\?|$) - reject-dict'
    - '^https?://api\.zhihu\.com/commercial_api(?:/|\?|$) - reject-dict'
    - '^https?://api\.zhihu\.com/bazaar/float_window(?:\?|$) - reject-dict'
    - '^https?://api\.zhihu\.com/api/v4/ecom_data/config(?:\?|$) - reject-dict'
  script:
    - match: '^https?://(?:[A-Za-z0-9-]+\.)+amap\.com/ws/(?:faas/amap-navigation/main-page|message/notice/list|msgbox/pull|promotion-web/resource|shield/(?:dsp/profile/index/nodefaas[^/?#]*|frogserver/aocs/updatable|search/(?:nearbyrec_smart|new_hotword))|valueadded/alimama/splash_screen)(?:[/?#]|$)'
      name: amap_response
      type: response
      require-body: true
      max-size: 0
      timeout: 30
    - match: '^https://newclient\.map\.baidu\.com/client/phpui2/\?qt=ads'
      name: baidu_map
      type: response
      require-body: true
      binary-mode: true
      max-size: 0
      timeout: 30
    - match: '^https://magev6\.if\.qidian\.com/argus/api/(?:v4/client/getsplashscreen|v2/(?:deeplink/geturl|dailyrecommend/getdailyrecommend)|v1/(?:client/getconf$|bookshelf/getHoverAdv|adv/getadvlistbatch\?positions=iOS_tab))'
      name: qidian
      type: response
      require-body: true
      max-size: 0
      timeout: 30
    - match: '^https?://(?:tiebac|c\.tieba)\.baidu\.com/(?:c/(?:s/sync|f/(?:ad/getSplashAd|frs/(?:page|threadlist|generalTabList)|pb/(?:pic)?page|excellent/personalized))$|tiebaads/commonbatch\?)'
      name: tieba_json
      type: response
      require-body: true
      max-size: 0
      timeout: 30
    - match: '^https?://(?:tiebac|c\.tieba)\.baidu\.com/c/(?:b/ad/adBid|f/(?:frs/(?:page|threadlist|generalTabList)|ad/getFeedAd|pb/page|excellent/personalized))\?cmd'
      name: tieba_proto
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 30
      argument: 'per_filter_video_thread=0'

script-providers:
  amap_response:
    url: https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/84477215bc16c39478203688fac8e2a943364c57/scripts/amap.js
    interval: 86400
  baidu_map:
    url: https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/84477215bc16c39478203688fac8e2a943364c57/scripts/baidu-map.js
    interval: 86400
  qidian:
    url: https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/84477215bc16c39478203688fac8e2a943364c57/scripts/qidian.js
    interval: 86400
  tieba_json:
    url: https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/84477215bc16c39478203688fac8e2a943364c57/scripts/tieba-json.js
    interval: 86400
  tieba_proto:
    url: https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/84477215bc16c39478203688fac8e2a943364c57/scripts/tieba-proto.js
    interval: 86400
